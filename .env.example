# Chaîne de connexion Neon (Postgres). Sans cette variable, l'application fonctionne en mode local (navigateur).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Code d'accès demandé par l'application (facultatif mais recommandé : les prénoms des enfants sont des données personnelles).
APP_PASSWORD=changez-moi
