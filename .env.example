# Chaîne de connexion Neon (Postgres). Sans cette variable, l'application fonctionne en mode local (navigateur).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Code d'accès demandé par l'application (facultatif mais recommandé : les prénoms des enfants sont des données personnelles).
APP_PASSWORD=changez-moi
# Jeton pour la connexion MCP (Claude, ChatGPT…). Si absent, APP_PASSWORD est utilisé.
MCP_TOKEN=changez-moi-aussi
# URL publique de l'application (lien « Ouvrir l'application » dans les réponses MCP). Déduite de l'hôte si absente.
# APP_URL=https://planning-creche-trezoclair.vercel.app
